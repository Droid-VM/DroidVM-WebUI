{
  "name": "droidvm-webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture": "depcruise src --config .dependency-cruiser.cjs",
    "contract:generate": "node scripts/contracts.mjs",
    "contract:check": "node scripts/contracts.mjs --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run contract:check && npm run typecheck && npm run lint && npm run architecture && npm run test"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.17.1",
    "lossless-json": "4.3.2",
    "vue": "3.5.44",
    "vue-i18n": "11.4.15",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.0",
    "@vitejs/plugin-vue": "6.0.10",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.0.18",
    "vue-tsc": "3.3.13",
    "ws": "8.22.0"
  }
}
